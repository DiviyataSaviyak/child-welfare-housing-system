# Copy to .env for local development. Never put production values in this file.

# Development database from docker-compose.dev.yml
DATABASE_URL="postgresql://diviyata:diviyata_dev@localhost:5433/diviyata?schema=public"

# Separate database used by `npm run test:db`
TEST_DATABASE_URL="postgresql://diviyata:diviyata_dev@localhost:5433/diviyata_test?schema=public"

# development | staging | ci | production.
APP_ENV="development"

# Better Auth. Generate a long random secret for each environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse the development secret anywhere else.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Private folder for uploaded files (ARC-5). Production uses /data/files on a Docker volume.
# Left empty, development uses data/files in the project, which git ignores.
# FILES_DIR="/data/files"

# SMS for forgotten passwords (AUTH-7, src/server/sms.ts). Left empty, development writes each
# message to data/sms-outbox.jsonl (or SMS_OUTBOX) and prints it in the dev server's terminal.
# SMS_URL='https://app.notify.lk/api/v1/send?user_id=...&api_key=...&sender_id=...&to={to}&message={text}'
