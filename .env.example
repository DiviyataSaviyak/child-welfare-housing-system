# Copy to .env for local development. Never put production values in this file.

# Development database from docker-compose.dev.yml
DATABASE_URL="postgresql://diviyata:diviyata_dev@localhost:5433/diviyata?schema=public"

# Separate database used by `npm run test:db`
TEST_DATABASE_URL="postgresql://diviyata:diviyata_dev@localhost:5433/diviyata_test?schema=public"

# development | staging | ci | production.
APP_ENV="development"

# Better Auth. Generate a long random secret for each environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse the development secret anywhere else.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Uploaded files (ARC-5). The servers set FILES_BUCKET and AWS_REGION: files go to that S3 bucket,
# with the AWS SDK's usual credentials. Left empty, they go to the private folder FILES_DIR, by
# default data/files in the project, which git ignores.
# FILES_BUCKET="the uploads bucket's name"
# AWS_REGION="ap-south-1"
# FILES_DIR="/data/files"

# Email for forgotten passwords (AUTH-7, src/server/mail.ts). Left empty, development writes each
# email to data/mail-outbox.jsonl (or MAIL_OUTBOX) and prints it in the dev server's terminal.
# To send real emails, fill these in; for a Gmail account, use an app password (the Docs repository's operations/RUNBOOK.md).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="your.account@gmail.com"
# SMTP_PASSWORD="the 16-letter app password, without spaces"
# MAIL_FROM="your.account@gmail.com"
