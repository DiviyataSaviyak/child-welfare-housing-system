# The server's scheduled jobs, installed by server-setup.sh as /etc/cron.d/diviyata.
# Times are Sri Lanka time (the server's time zone is Asia/Colombo). Output goes to the system
# journal: journalctl -t diviyata-backup, and so on.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# OPS-4: the site through HTTPS, and the disk, every 5 minutes.
*/5 * * * *  deploy  /opt/diviyata/scripts/monitor.sh 2>&1 | logger -t diviyata-monitor

# SEC-10: the nightly backup, before the 03:30 security reboot.
30 1 * * *   root    /opt/diviyata/scripts/backup.sh 2>&1 | logger -t diviyata-backup

# SEC-10: the monthly restore test, on the 1st.
30 2 1 * *   root    /opt/diviyata/scripts/restore.sh --test 2>&1 | logger -t diviyata-restore-test
