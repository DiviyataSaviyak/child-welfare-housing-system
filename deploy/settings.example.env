# The settings of deploy/ops.sh. Copy this file to settings.env in the same folder and fill it
# in. settings.env is ignored by git: it names your key file and holds the
# healthchecks.io API key. Values with spaces need quotes.

# ---- The server (RUNBOOK step 1) --------------------------------------------------------------
# The Elastic IP attached to the EC2 instance.
SERVER_IP=
# The key pair's .pem file, as downloaded from AWS (C:/Users/<you>/Downloads/diviyata.pem works).
SSH_KEY=
# Ubuntu's own user on the instance; leave it unless you changed the AMI.
SSH_USER=ubuntu

# ---- The site ---------------------------------------------------------------------------------
# The domain name, with its A record already pointing at SERVER_IP. Leave it empty until the
# Ministry's domain arrives: the scripts then use <ip-with-dashes>.sslip.io, which needs no DNS.
DOMAIN=
# Let's Encrypt writes here about the certificate.
OPS_EMAIL=

# ---- Backups (deploy/README.md, "AWS, once") --------------------------------------------------
# The S3 bucket's name only, for example diviyata-backups-123456789012 (your 12-digit AWS account
# id, from the menu under your name at the console's top right, keeps it unique). The server reaches
# the bucket through its IAM role, diviyata-server, so no AWS user or access key goes here.
BACKUP_BUCKET=
# The region of the bucket and the server: ap-south-1 is Mumbai, ap-southeast-1 is Singapore.
AWS_REGION=ap-south-1
BACKUP_FOLDER=diviyata

# ---- Alerts (RUNBOOK step 2) ------------------------------------------------------------------
# Easiest: in healthchecks.io, make a project, add Head Office's contact under Integrations >
# Email, then Settings > API Access > create a read-write API key and paste it here. The scripts
# make the three checks (monitor, backup, restore test) themselves.
HC_API_KEY=
# Or leave HC_API_KEY empty and paste the three ping URLs of checks you made by hand.
HC_MONITOR_URL=
HC_BACKUP_URL=
HC_RESTORE_URL=

# ---- GitHub (RUNBOOK step 4) ------------------------------------------------------------------
# owner/name; empty: this checkout's own repository.
GITHUB_REPO=
# yes: main needs a pull request with the CI checks passing (you, as the owner, can still push).
PROTECT_MAIN=yes

# ---- The first admin (RUNBOOK step 6) ---------------------------------------------------------
# Used by setup.sh (if ADMIN_NAME is set) and by create-admin.sh. The mobile is 07XXXXXXXX.
ADMIN_NAME=
ADMIN_MOBILE=
ADMIN_DESIGNATION=
ADMIN_EMAIL=
