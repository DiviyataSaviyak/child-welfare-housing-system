# The server's settings: /opt/diviyata/.env, readable only by the deploy user and root (SEC-9).
# server-setup.sh writes it from this file, generates the secrets and never overwrites a value
# that is already set. Values are plain: no quotes, no spaces.

# ---- The site ---------------------------------------------------------------------------------
# The domain name pointed at the server's Elastic IP. Caddy gets its certificate for it.
SITE_DOMAIN=
# Let's Encrypt writes here about the certificate (expiry warnings, problems).
ACME_EMAIL=
# staging until launch (made-up data only), then production (OPS-1, task 9.13).
APP_ENV=staging

# ---- Secrets, generated by server-setup.sh ----------------------------------------------------
# The database owner, who runs the migrations, the seed and the grants.
DB_OWNER_PASSWORD=
# The app's own account, diviyata_app (SEC-3).
APP_DB_PASSWORD=
# Signs the sessions. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Encrypts the backups. Keep a copy off the server, with the Ministry (SEC-10): without it the
# backups can't be read. Never change it once the first backup is made.
RESTIC_PASSWORD=

# ---- Backups (SEC-10) -------------------------------------------------------------------------
# s3:s3.<region>.amazonaws.com/<bucket>/<folder>. The server reaches it with its own AWS role.
RESTIC_REPOSITORY=

# ---- Alerts (OPS-4): healthchecks.io ping URLs, one check each. Empty: no reports. ------------
HC_MONITOR_URL=
HC_BACKUP_URL=
HC_RESTORE_URL=
