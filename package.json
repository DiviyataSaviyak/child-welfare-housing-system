    "cn": "0.4.0",
    "exceljs": "4.4.0",
    "lucide-react": "1.48.0",
    "next": "16.3.8",
    "next-intl": "4.14.7",
    "nodemailer": "10.0.13",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tw-animate-css": "1.4.0",
