{
  "name": "diviyata-saviyak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:strings": "tsx scripts/check-strings.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed-load": "tsx scripts/seed-load.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.6",
