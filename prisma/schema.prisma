// Diviyata Saviyak database schema. The application spec's Data model (the Docs repository's
// docs/specs/application.md) describes each entity.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Kind of help (application spec, Data model). Land-only cases are out of scope.
enum Kind {
  NEW_HOUSE
  RENOVATION
}

/// Which of the sheet's two lists a beneficiary belongs to (application spec, Data model).
enum Category {
  CARE_LEAVER
  CHILD_AT_RISK
}

/// A case's status (application spec, Case statuses and transitions). Only the moves listed there are allowed (STS-1).
/// Change 0006 has five: awaiting the Ministry's allocation, allocated to the district, released to the DS
/// (allocation received), in progress and completed. The migration `20261109120000_allocation_flow` moved
/// every case to them.
enum CaseStatus {
  AWAITING_ALLOCATION
  ALLOCATED_TO_DISTRICT
  ALLOCATION_RECEIVED
  IN_PROGRESS
  COMPLETED
  /// Version 1's statuses, below. No case holds one after the migration. They stay only while the code for
  /// drafts, the check, stopping and version 1's letter is still there, and go with it (change 0006, task 5).
  DRAFT
  SUBMITTED
  RETURNED
  VERIFIED
  REJECTED
  STOPPED
}

enum DecisionType {
  SUBMIT
  VERIFY
  SEND_BACK
  REJECT
  STOP
  REOPEN
}

/// An installment's status (application spec, Data model, INS-3, INS-4).
enum InstallmentStatus {
  NOT_STARTED
  PROCESSING
  RELEASED
}

/// What an uploaded file is for: one of a case's other documents (CASE-2), a photo of its building
/// progress (STG-1), which is resized and stripped of its metadata on upload (STG-3), or the scan of an
/// allocation letter (REL-2).
enum FileKind {
  DOCUMENT
  PHOTO
  LETTER
}

/// What a notification tells an officer about a case (NTF-1). SENT_BACK, VERIFIED, REJECTED, STOPPED and
/// REOPENED are no longer made once change 0006 is built; they stay for the notifications that hold them.
enum NotificationType {
  SENT_BACK
  VERIFIED
  REJECTED
  RELEASED
  COMPLETED
  STOPPED
  REOPENED
  /// The Ministry's letter allocated the case to its district (REL-3).
  ALLOCATED
  /// For a District officer: a Ministry letter to the district (NTF-1).
  DISTRICT_LETTER
}

/// Places and stages carry a name in each screen language (UI-9).
model Province {
  id        Int        @id @default(autoincrement())
  nameEn    String     @unique @map("name_en")
  nameSi    String     @unique @map("name_si")
  nameTa    String     @unique @map("name_ta")
  districts District[]
  users     User[]

  @@map("province")
}

model District {
  id         Int             @id @default(autoincrement())
  nameEn     String          @unique @map("name_en")
  nameSi     String          @unique @map("name_si")
  nameTa     String          @unique @map("name_ta")
  provinceId Int             @map("province_id")
  province   Province        @relation(fields: [provinceId], references: [id])
  dsOffices  DsOffice[]
  letters    ReleaseLetter[]
  dsReleases DsRelease[]
  users      User[]

  @@index([provinceId])
  @@map("district")
}

/// A Divisional Secretariat. Never deleted: inactive offices keep their accounts and cases (LST-3).
model DsOffice {
  id         Int         @id @default(autoincrement())
  /// Three capital letters, unique nationally, used in case numbers (CASE-5).
  code       String      @unique @db.Char(3)
  nameEn     String      @map("name_en")
  nameSi     String      @map("name_si")
  nameTa     String      @map("name_ta")
  districtId Int         @map("district_id")
  district   District    @relation(fields: [districtId], references: [id])
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  users      User[]
  /// The cases of the people who live in this DS division.
  cases      Case[]      @relation("CaseResidence")
  /// The cases whose house is built, or land bought, in this DS division (CASE-13).
  casesBuilt Case[]      @relation("CaseBuilt")
  dsReleases DsRelease[]

  @@unique([districtId, nameSi])
  @@index([districtId])
  @@map("ds_office")
}

/// Building stages per kind of help (LST-4). A used stage is deactivated, never removed.
model StageDefinition {
  id        Int           @id @default(autoincrement())
  kind      Kind
  sortOrder Int           @map("sort_order")
  nameSi    String        @map("name_si")
  nameTa    String        @map("name_ta")
  nameEn    String        @map("name_en")
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  updates   StageUpdate[]

  @@unique([kind, nameSi])
  @@index([kind, sortOrder])
  @@map("stage_definition")
}

/// Append-only history of every change (HIS-1). The app's database role may only insert and read (HIS-3, Phase 2).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  /// The signed-in user; empty for system actions such as the seed.
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  caseId     String?  @map("case_id")
  before     Json?
  after      Json?

  @@index([entityType, entityId])
  @@index([caseId])
  @@index([at])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Sign-in (Phase 2). User, Session, Account and Verification follow the fields Better Auth 1.7
// expects, including its username and admin plugins. The other fields are ours (application spec, Data model).
// ---------------------------------------------------------------------------

/// An officer's account. Never deleted (ADM-7).
model User {
  id                     String          @id
  /// The officer's full name.
  name                   String
  /// Better Auth needs a unique address; officers without one get a placeholder (see src/lib/auth.ts).
  email                  String          @unique
  emailVerified          Boolean         @default(false) @map("email_verified")
  image                  String?
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  /// Generated sign-in name such as ds0101 (ADM-2).
  username               String?         @unique
  displayUsername        String?         @map("display_username")
  /// DS_OFFICER, DISTRICT_OFFICER, MINISTRY_OFFICER, VIEWER or ADMIN; a database check allows nothing else.
  /// The designation decides it (src/server/auth/designations.ts).
  role                   String?
  /// true means the account is disabled (ADM-6).
  banned                 Boolean         @default(false)
  banReason              String?         @map("ban_reason")
  banExpires             DateTime?       @map("ban_expires")
  /// A code from src/server/auth/designations.ts; an admin has none. A database check holds the pairs of
  /// role and designation.
  designation            String?
  mobile                 String?
  /// The officer's real email address, if they have one. Codes for a forgotten password go to it (AUTH-7).
  contactEmail           String?         @map("contact_email")
  /// An account has the one place its office type belongs to and no other (checked by the database): a DS
  /// office, a district or a province. An office can have several accounts (ADM-3, ADM-9).
  dsOfficeId             Int?            @map("ds_office_id")
  dsOffice               DsOffice?       @relation(fields: [dsOfficeId], references: [id])
  districtId             Int?            @map("district_id")
  district               District?       @relation(fields: [districtId], references: [id])
  provinceId             Int?            @map("province_id")
  province               Province?       @relation(fields: [provinceId], references: [id])
  mustChangePassword     Boolean         @default(true) @map("must_change_password")
  /// When the current temporary password was issued; it stops working after 7 days (SEC-4).
  temporaryPasswordSetAt DateTime?       @map("temporary_password_set_at")
  failedSignIns          Int             @default(0) @map("failed_sign_ins")
  lockedUntil            DateTime?       @map("locked_until")
  lastSignInAt           DateTime?       @map("last_sign_in_at")
  sessions               Session[]
  accounts               Account[]
  casesCreated           Case[]
  decisions              Decision[]
  filesUploaded          StoredFile[]
  releases               Release[]
  releaseLetters         ReleaseLetter[]
  dsReleases             DsRelease[]
  notifications          Notification[]
  stageUpdates           StageUpdate[]
  resetCodes             ResetCode[]

  @@index([dsOfficeId])
  @@index([districtId])
  @@index([provinceId])
  @@map("app_user")
}

model Session {
  id             String   @id
  /// At most 12 hours after sign-in (AUTH-4).
  expiresAt      DateTime @map("expires_at")
  token          String   @unique
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @map("impersonated_by")
  /// Ours: the session ends after 30 minutes without activity (AUTH-4).
  lastActiveAt   DateTime @default(now()) @map("last_active_at")

  @@index([userId])
  @@map("session")
}

/// Holds the password hash (provider "credential").
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

/// A code sent by email to reset a forgotten password (AUTH-7). The browser holds a random ticket; the
/// row's id is the ticket's SHA-256 and the code is kept only as an HMAC. A ticket for an unknown
/// username, a disabled account, one with no email address or one over its daily limit has no user and
/// no email goes out, so the page acts the same for any username.
model ResetCode {
  id        String    @id
  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  /// 15 minutes after sending, for typing the code and setting the new password.
  expiresAt DateTime  @map("expires_at")
  /// Wrong codes typed so far; at 5 the ticket stops working.
  tries     Int       @default(0)
  /// When the right code was typed; the new password may then be set until it expires.
  checkedAt DateTime? @map("checked_at")

  @@index([userId, createdAt])
  @@map("password_reset_code")
}

/// SEC-4: attempts per client address in a fixed window, for each limit ("sign-in", "reset-code"). In
/// the database, so every app container counts against the same limit. The key is the limit's name and
/// an HMAC of the address; the next attempt against a limit removes its windows that have ended.
model RateLimit {
  key         String   @id
  /// The window's first attempt.
  windowStart DateTime @map("window_start")
  /// Attempts in the window so far, the refused ones too.
  count       Int

  @@map("rate_limit")
}

/// AUTH-2: the wrong tries and lock of a username that has no account. They count and lock exactly as
/// an account's own do, so the sign-in page never shows whether a username exists. The name is kept only
/// as an HMAC, because it is sometimes a password typed into the wrong box.
model UnknownSignInName {
  nameHash      String    @id @map("name_hash")
  failedSignIns Int       @default(0) @map("failed_sign_ins")
  lockedUntil   DateTime? @map("locked_until")
  /// A name with no wrong try for 30 days is forgotten.
  lastTriedAt   DateTime  @map("last_tried_at")

  @@index([lastTriedAt])
  @@map("unknown_sign_in_name")
}

// ---------------------------------------------------------------------------
// Cases (Phase 4). Application spec, Data model; the rules for each field are in CASE-2.
// ---------------------------------------------------------------------------

/// A beneficiary's case. Never deleted, except drafts (CASE-8).
model Case {
  id                   String         @id
  /// The Application Number (ඉල්ලුම් අංකය) the DS types from the paper application, kept as typed without
  /// spaces at either end (CASE-12). The migration made each case number one. Empty only on a draft.
  applicationNumber    String?        @map("application_number")
  /// The Application Number in capitals without spaces (`applicationKey` in src/server/cases/numbers.ts):
  /// unique within the DS office of residence.
  applicationKey       String?        @map("application_key")
  /// The DS office of residence: it enters the case, and edits it while it awaits its allocation.
  dsOfficeId           Int            @map("ds_office_id")
  dsOffice             DsOffice       @relation("CaseResidence", fields: [dsOfficeId], references: [id])
  /// The DS office where the house is built or the land bought (CASE-13): the DS office of residence
  /// unless the form says otherwise. The money, the installments and the stages follow it.
  buildDsOfficeId      Int            @map("build_ds_office_id")
  buildDsOffice        DsOffice       @relation("CaseBuilt", fields: [buildDsOfficeId], references: [id])
  /// Category and kind may be empty only while the case is a draft (CASE-4).
  category             Category?
  kind                 Kind?
  status               CaseStatus     @default(DRAFT)
  /// The care leaver, or the guardian of a child at risk.
  name                 String?
  /// Only for children at risk.
  childName            String?        @map("child_name")
  /// As entered, in capitals without spaces.
  nic                  String?
  /// The NIC in its 12-digit form, so old and new numbers match (CASE-6).
  nicKey               String?        @map("nic_key")
  address              String?
  /// The Grama Niladhari division (ග්‍රාම නිලධාරී වසම), as typed. Optional.
  gnDivision           String?        @map("gn_division")
  mobile1              String?        @map("mobile_1")
  mobile2              String?        @map("mobile_2")
  remark               String?
  createdById          String         @map("created_by_id")
  createdBy            User           @relation(fields: [createdById], references: [id])
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  /// The latest submit. The check queue lists the oldest first (CHK-1).
  submittedAt          DateTime?      @map("submitted_at")
  /// When Head Office verified it. The release queue lists the oldest first (REL-1).
  verifiedAt           DateTime?      @map("verified_at")
  /// When the system found it finished (CLS-1).
  completedAt          DateTime?      @map("completed_at")
  /// While the case is stopped: the status it goes back to when it is reopened (CLS-3).
  statusBeforeStop     CaseStatus?    @map("status_before_stop")
  /// Head Office asked the DS office for another name in this case's place when it rejected or stopped
  /// it (CASE-11). Only a rejected or stopped case has it (a database check); reopening clears it.
  anotherNameRequested Boolean        @default(false) @map("another_name_requested")
  /// The rejected or stopped case this one was entered in place of (CASE-11). A case is replaced once.
  replacesCaseId       String?        @unique @map("replaces_case_id")
  replaces             Case?          @relation("Replacement", fields: [replacesCaseId], references: [id], onDelete: SetNull)
  replacedBy           Case?          @relation("Replacement")
  /// Goes up by one on every save, so a form opened earlier can't overwrite a newer change (CASE-10).
  version              Int            @default(1)
  decisions            Decision[]
  files                StoredFile[]
  release              Release?
  installments         Installment[]
  notifications        Notification[]
  stageUpdates         StageUpdate[]

  @@unique([dsOfficeId, applicationKey])
  @@index([dsOfficeId, status])
  @@index([buildDsOfficeId, status])
  @@index([status, submittedAt])
  @@index([status, verifiedAt])
  @@index([nicKey])
  @@index([updatedAt])
  @@map("case")
}

/// The last case number given in each DS office and year (version 1's CASE-5). Taking the next number locks
/// the row, so two submits at the same moment take turns and never get the same number. It goes with the
/// drafts (change 0006, task 4), since the DS types the Application Number.
model CaseNumberCounter {
  dsOfficeId Int @map("ds_office_id")
  year       Int
  last       Int

  @@id([dsOfficeId, year])
  @@map("case_number_counter")
}

/// A step in a case's life, with the reason when one is needed (CHK-3, CLS-2, CLS-3).
model Decision {
  id     String       @id
  caseId String       @map("case_id")
  case   Case         @relation(fields: [caseId], references: [id])
  type   DecisionType
  reason String?
  byId   String       @map("by_id")
  by     User         @relation(fields: [byId], references: [id])
  at     DateTime     @default(now())

  @@index([caseId, at])
  @@map("decision")
}

/// An uploaded file, kept under a random name in the private folder (ARC-5, SEC-7). It belongs to the
/// person who uploaded it until a case is saved with it; from then on, the case's office rules decide
/// who may open it.
model StoredFile {
  id            String         @id
  kind          FileKind       @default(DOCUMENT)
  /// Empty between the upload and the save of the case form or the stage update.
  caseId        String?        @map("case_id")
  case          Case?          @relation(fields: [caseId], references: [id], onDelete: Restrict)
  /// A photo's stage update; empty for a document (a database check).
  stageUpdateId String?        @map("stage_update_id")
  stageUpdate   StageUpdate?   @relation(fields: [stageUpdateId], references: [id], onDelete: Restrict)
  /// A letter scan's allocation letter; empty for anything else (a database check). Empty between the
  /// upload and the save of the letter.
  letterId      String?        @map("letter_id")
  letter        ReleaseLetter? @relation(fields: [letterId], references: [id], onDelete: Restrict)
  /// A letter scan's District release (REL-6); empty for anything else. A scan never has both a letter and
  /// a District release (a database check).
  dsReleaseId   String?        @map("ds_release_id")
  dsRelease     DsRelease?     @relation(fields: [dsReleaseId], references: [id], onDelete: Restrict)
  /// A random name with no extension; the type comes from the contents (SEC-7).
  storedName    String         @unique @map("stored_name")
  /// A photo's small copy for thumbnails (STG-6), under its own random name; empty for a document.
  thumbName     String?        @unique @map("thumb_name")
  originalName  String         @map("original_name")
  mimeType      String         @map("mime_type")
  size          Int
  sha256        String         @db.Char(64)
  uploadedById  String         @map("uploaded_by_id")
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime       @default(now()) @map("uploaded_at")
  /// Taken off the case. The file is kept, because nothing on a case is deleted (section 5).
  removedAt     DateTime?      @map("removed_at")
  removedById   String?        @map("removed_by_id")

  @@index([caseId])
  @@index([uploadedById, caseId])
  @@index([stageUpdateId])
  @@index([letterId])
  @@index([dsReleaseId])
  @@map("file")
}

// ---------------------------------------------------------------------------
// Check and release (Phase 5). Application spec: Head Office check, the Rs. 2,000,000 release,
// Installments, History and notifications.
// ---------------------------------------------------------------------------

/// One allocation letter (ප්‍රතිපාදන ලිපිය) from Head Office to a District Secretary: Rs. 2,000,000 for each
/// of several verified cases of that district, which the District gives out through each case's DS
/// office (REL-2, 6 Oct 2026).
model ReleaseLetter {
  id           String       @id
  districtId   Int          @map("district_id")
  district     District     @relation(fields: [districtId], references: [id])
  /// As written on the letter, such as MWCA/3/8/16/04-2026.
  letterNumber String       @map("letter_number")
  /// A calendar day, never in the future and never before the verification of one of its cases.
  letterDate   DateTime     @map("letter_date") @db.Date
  /// The letter's "valid only until" day; never before its date (a database check).
  validUntil   DateTime     @map("valid_until") @db.Date
  note         String?
  byId         String       @map("by_id")
  by           User         @relation(fields: [byId], references: [id])
  at           DateTime     @default(now())
  releases     Release[]
  /// The scanned letter, if one was added.
  files        StoredFile[]

  @@index([at])
  @@map("release_letter")
}

/// The Rs. 2,000,000 the Ministry allocates for a case through its district's allocation letter (REL-3),
/// and, once the District releases it to the DS where it is built, that release (REL-7). One per case.
model Release {
  id           String        @id
  caseId       String        @unique @map("case_id")
  case         Case          @relation(fields: [caseId], references: [id])
  letterId     String        @map("letter_id")
  letter       ReleaseLetter @relation(fields: [letterId], references: [id])
  /// The letter's date. Correcting the letter's date changes it on every release of the letter (REL-4).
  releasedOn   DateTime      @map("released_on") @db.Date
  /// The District's release to the DS; empty until then. Set together with `dsReleasedOn` (a database check).
  dsReleaseId  String?       @map("ds_release_id")
  dsRelease    DsRelease?    @relation(fields: [dsReleaseId], references: [id], onDelete: Restrict)
  /// The District release's date, kept here for the installment and stage date rules (INS-3, INS-4,
  /// STG-1). Correcting the release's date changes it on every case of the release (REL-8).
  dsReleasedOn DateTime?     @map("ds_released_on") @db.Date
  /// Always 2,000,000 (a database check).
  amount       Int
  byId         String        @map("by_id")
  by           User          @relation(fields: [byId], references: [id])
  at           DateTime      @default(now())

  @@index([letterId])
  @@index([dsReleaseId])
  @@map("release")
}

/// The District's release (දිස්ත්‍රික් මුදා හැරීම) to one of its DS offices of cases the Ministry allocated to
/// the district (REL-6). The command checks that the office is in the district and that the day is never
/// before the Ministry's letter of any of its cases.
model DsRelease {
  id              String       @id
  districtId      Int          @map("district_id")
  district        District     @relation(fields: [districtId], references: [id])
  dsOfficeId      Int          @map("ds_office_id")
  dsOffice        DsOffice     @relation(fields: [dsOfficeId], references: [id])
  /// As on the District's letter or voucher.
  referenceNumber String       @map("reference_number")
  /// A calendar day, never in the future.
  releasedOn      DateTime     @map("released_on") @db.Date
  note            String?
  byId            String       @map("by_id")
  by              User         @relation(fields: [byId], references: [id])
  at              DateTime     @default(now())
  releases        Release[]
  /// The scanned letter, if one was added.
  files           StoredFile[]

  @@index([districtId, at])
  @@index([dsOfficeId])
  @@map("ds_release")
}

/// One of the four payments of Rs. 500,000 to the beneficiary (INS-1). All four are made with the release.
model Installment {
  id         String            @id
  caseId     String            @map("case_id")
  case       Case              @relation(fields: [caseId], references: [id])
  /// 1 to 4 (a database check).
  number     Int
  /// Always 500,000 (a database check).
  amount     Int
  status     InstallmentStatus @default(NOT_STARTED)
  purpose    String?
  /// A calendar day, set when the payment is started (INS-3).
  expectedOn DateTime?         @map("expected_on") @db.Date
  /// A calendar day, set when it is paid (INS-4).
  releasedOn DateTime?         @map("released_on") @db.Date
  note       String?
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@unique([caseId, number])
  @@map("installment")
}

/// Tells one officer that something happened to a case (NTF-1). Opening it marks it read.
model Notification {
  id        String           @id
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id])
  caseId    String           @map("case_id")
  case      Case             @relation(fields: [caseId], references: [id])
  type      NotificationType
  createdAt DateTime         @default(now()) @map("created_at")
  readAt    DateTime?        @map("read_at")

  @@index([userId, readAt])
  @@index([caseId])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Installments, building progress and closing (Phase 6). Application spec: Installments, Building
// progress, Completing, stopping and reopening.
// ---------------------------------------------------------------------------

/// Building progress recorded by the DS office (STG-1): a stage reached, or a visit with only a note.
/// Choosing a stage further ahead also adds a row for each stage it skips, on the same day (STG-2).
/// A case's current stage is the highest stage it has reached.
model StageUpdate {
  id        String           @id
  caseId    String           @map("case_id")
  case      Case             @relation(fields: [caseId], references: [id])
  /// The stage reached; empty for a note-only visit. Each stage is reached once per case.
  stageId   Int?             @map("stage_id")
  stage     StageDefinition? @relation(fields: [stageId], references: [id], onDelete: Restrict)
  /// A calendar day: the visit, or the day the stage was reached.
  visitedOn DateTime         @map("visited_on") @db.Date
  note      String?
  byId      String           @map("by_id")
  by        User             @relation(fields: [byId], references: [id])
  at        DateTime         @default(now())
  photos    StoredFile[]

  @@unique([caseId, stageId])
  @@index([caseId, at])
  @@map("stage_update")
}
